<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Deployment.Desktop.Views"
             x:Class="Deployment.Desktop.Views.BackupsView"
             x:CompileBindings="False">
    <DockPanel>
        <TextBlock Name="Header" DockPanel.Dock="Top" FontWeight="Bold" FontSize="18" Margin="0,0,0,12" />
        <views:TargetSelector Name="Selector" DockPanel.Dock="Top" Margin="0,0,0,12" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Name="CreateBackupButton" Click="OnCreateBackupClick" />
            <Button Name="ProtectButton" Click="OnProtectClick" />
            <Button Name="CleanupButton" Click="OnCleanupClick" />
            <Button Name="RefreshButton" Click="OnRefreshClick" />
        </StackPanel>
        <DataGrid Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Backup ID" Binding="{Binding BackupId}" Width="220" />
                <DataGridTextColumn Header="Release" Binding="{Binding Release}" Width="100" />
                <DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="150" />
                <DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="70" />
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                <DataGridTextColumn Header="Protected" Binding="{Binding Protected}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

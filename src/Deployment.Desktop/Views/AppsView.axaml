<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dg="using:Avalonia.Controls"
             x:Class="Deployment.Desktop.Views.AppsView"
             x:CompileBindings="False">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBlock Name="Header" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Name="CreateAppButton" Click="OnCreateAppClick" />
            <Button Name="AddEnvButton" Click="OnAddEnvClick" />
            <Button Name="AddTargetButton" Click="OnAddTargetClick" />
            <Button Name="RefreshButton" Click="OnRefreshClick" />
        </StackPanel>
        <DataGrid Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Application" Binding="{Binding AppName}" Width="200" />
                <DataGridTextColumn Header="Environments" Binding="{Binding EnvNames}" Width="200" />
                <DataGridTextColumn Header="Targets" Binding="{Binding TargetSummary}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Deployment.Desktop.Views.RecoveryView"
             x:CompileBindings="False">
    <DockPanel>
        <TextBlock Name="Header" DockPanel.Dock="Top" FontWeight="Bold" FontSize="18" Margin="0,0,0,12" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Name="MarkFailedButton" Click="OnMarkFailedClick" />
            <Button Name="RefreshButton" Click="OnRefreshClick" />
        </StackPanel>
        <TextBlock Name="EmptyText" DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,8" />
        <DataGrid Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Deployment ID" Binding="{Binding DeploymentId}" Width="220" />
                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="200" />
                <DataGridTextColumn Header="Release" Binding="{Binding Release}" Width="90" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="150" />
                <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

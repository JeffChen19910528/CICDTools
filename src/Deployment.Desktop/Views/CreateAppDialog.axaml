<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Deployment.Desktop.Views.CreateAppDialog"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Name="Header" FontWeight="Bold" FontSize="16" />
        <StackPanel Spacing="4">
            <TextBlock Name="NameLabel" FontSize="12" Foreground="Gray" />
            <TextBox Name="NameBox" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Name="DescLabel" FontSize="12" Foreground="Gray" />
            <TextBox Name="DescBox" />
        </StackPanel>
        <TextBlock Name="ErrorText" Foreground="OrangeRed" IsVisible="False" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="CancelButton" Content="Cancel" Click="OnCancelClick" />
            <Button Name="OkButton" Content="OK" Click="OnOkClick" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>

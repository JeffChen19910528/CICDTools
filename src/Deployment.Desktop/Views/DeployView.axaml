<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Deployment.Desktop.Views"
             x:Class="Deployment.Desktop.Views.DeployView"
             x:CompileBindings="False">
    <DockPanel>
        <TextBlock Name="Header" DockPanel.Dock="Top" FontWeight="Bold" FontSize="18" Margin="0,0,0,12" />
        <views:TargetSelector Name="Selector" DockPanel.Dock="Top" Margin="0,0,0,12" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Name="DiffButton" Click="OnDiffClick" />
            <Button Name="DryRunButton" Click="OnDryRunClick" />
            <Button Name="DeployButton" Click="OnDeployClick" Classes="accent" />
            <Button Name="RollbackButton" Click="OnRollbackClick" />
        </StackPanel>
        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="12">
            <ScrollViewer>
                <TextBlock Name="ResultText" TextWrapping="Wrap" FontFamily="Consolas,monospace" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>

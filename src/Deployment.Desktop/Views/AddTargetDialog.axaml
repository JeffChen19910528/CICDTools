<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Deployment.Desktop.Views.AddTargetDialog"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Name="Header" FontWeight="Bold" FontSize="16" />
        <StackPanel Spacing="4">
            <TextBlock Name="AppLabel" FontSize="12" Foreground="Gray" />
            <ComboBox Name="AppCombo" HorizontalAlignment="Stretch" SelectionChanged="OnAppChanged" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Name="EnvLabel" FontSize="12" Foreground="Gray" />
            <ComboBox Name="EnvCombo" HorizontalAlignment="Stretch" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Name="NameLabel" FontSize="12" Foreground="Gray" />
            <TextBox Name="NameBox" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Name="OsLabel" FontSize="12" Foreground="Gray" />
            <ComboBox Name="OsCombo" HorizontalAlignment="Stretch" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Name="HostLabel" FontSize="12" Foreground="Gray" />
            <TextBox Name="HostBox" Text="localhost" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Name="PathLabel" FontSize="12" Foreground="Gray" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Name="PathBox" Grid.Column="0" />
                <Button Name="BrowseButton" Grid.Column="1" Margin="8,0,0,0" Click="OnBrowseClick" />
            </Grid>
        </StackPanel>
        <TextBlock Name="ErrorText" Foreground="OrangeRed" IsVisible="False" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="CancelButton" Content="Cancel" Click="OnCancelClick" />
            <Button Name="OkButton" Content="OK" Click="OnOkClick" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>

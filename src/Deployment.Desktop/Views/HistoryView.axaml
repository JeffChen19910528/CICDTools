<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Deployment.Desktop.Views"
             x:Class="Deployment.Desktop.Views.HistoryView"
             x:CompileBindings="False">
    <DockPanel>
        <TextBlock Name="Header" DockPanel.Dock="Top" FontWeight="Bold" FontSize="18" Margin="0,0,0,12" />
        <TabControl Name="Tabs">
            <TabItem Name="DeployTab">
                <DockPanel>
                    <views:TargetSelector Name="Selector" DockPanel.Dock="Top" Margin="0,0,0,12" />
                    <DataGrid Name="DeployGrid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Deployment ID" Binding="{Binding DeploymentId}" Width="220" />
                            <DataGridTextColumn Header="Release" Binding="{Binding Release}" Width="90" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                            <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="120" />
                            <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="150" />
                            <DataGridTextColumn Header="Completed" Binding="{Binding Completed}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Name="AuditTab">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <TextBlock Name="AuditAppLabel" VerticalAlignment="Center" />
                        <ComboBox Name="AuditAppCombo" Width="200" SelectionChanged="OnAuditFilterChanged" />
                        <TextBlock Name="AuditEnvLabel" VerticalAlignment="Center" />
                        <ComboBox Name="AuditEnvCombo" Width="160" SelectionChanged="OnAuditFilterChanged" />
                        <Button Name="AuditRefreshButton" Click="OnAuditRefreshClick" />
                    </StackPanel>
                    <DataGrid Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="150" />
                            <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="180" />
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="180" />
                            <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="100" />
                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90" />
                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
